generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Workspace {
  id           String        @id @default(uuid())
  nome         String
  tipo         String        // Ex: "PESSOAL" ou "DOCE_METADE"
  transacoes   Transaction[]
  criado_em    DateTime      @default(now())
}

model CreditCard {
  id             String        @id @default(uuid())
  nome_cartao    String        // Ex: "Nubank", "Ailos"
  dia_fechamento Int
  dia_vencimento Int
  transacoes     Transaction[]
}

model Transaction {
  id                  String      @id @default(uuid())
  descricao           String
  lugar               String?  
  cor_grupo           String?  
  valor               Float
  data                DateTime
  tipo                String      // "RECEITA" ou "DESPESA"
  categoria           String      @default("Outros")
  status              String      // "PENDENTE" ou "PAGO"

  // Isolamento entre vida pessoal e o negócio
  workspace           Workspace   @relation(fields: [workspace_id], references: [id])
  workspace_id        String

  // Motor de Acertos (Divisão de custos do casal)
  compartilhado       Boolean     @default(false)
  pago_por            String?     // Ex: "MARCOS" ou "STHE"

  // Controle de Cartões de Crédito e Parcelas
  cartao              CreditCard? @relation(fields: [cartao_id], references: [id])
  cartao_id           String?
  parcela_atual       Int?        // Ex: 1
  total_parcelas      Int?        // Ex: 6

  criado_em           DateTime    @default(now())
}
model Estoque {
  id         String   @id @default(uuid())
  nome       String
  quantidade Float    @default(0)    // <-- Mudou de Int para Float
  unidade    String   @default("un") // <-- NOVA LINHA
  categoria  String
  imagem     String?  @db.Text // O '@db.Text' permite guardar imagens convertidas em texto (Base64)
  criado_em  DateTime @default(now())
}
// 1. Tabela para registrar o histórico dos fechamentos do dia
model FechamentoDoceMetade {
  id               String   @id @default(uuid())
  data_fechamento  DateTime @default(now())
  
  // Valores Brutos e Rateio
  faturamento_total Float
  caixa_insumos     Float   // 50%
  custo_carro       Float   // R$ 32,00
  lucro_limpo       Float   // O que sobrou
  
  // Divisão do Lucro
  pro_labore_casal  Float   // 60% do lucro limpo
  lucro_empresa     Float   // 40% do lucro limpo
  
  criado_em         DateTime @default(now())
}

// 2. Tabela para guardar o Saldo Virtual Acumulado das Caixinhas
model CaixinhaVirtual {
  id          String   @id @default(uuid())
  nome        String   @unique // "INSUMOS", "CARRO", "PRO_LABORE", "EMPRESA"
  saldo_atual Float    @default(0)
  atualizado_em DateTime @updatedAt
}